#version 450
#extension GL_ARB_separate_shader_objects : enable

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
    vec4 velocity;
};

// TODO: Add bindings to:
// 1. Store the input blades
// 2. Write out the culled blades
// 3. Write the total number of blades remaining

// The project is using vkCmdDrawIndirect to use a buffer as the arguments for a draw call
// This is sort of an advanced feature so we've showed you what this buffer should look like
//
// layout(set = ???, binding = ???) buffer NumBlades {
// 	  uint vertexCount;   // Write the number of blades remaining here
// 	  uint instanceCount; // = 1
// 	  uint firstVertex;   // = 0
// 	  uint firstInstance; // = 0
// } numBlades;




layout(set = 2, binding = 0) buffer InputBlades {
    Blade blades[];
} inputBlades;

layout(set = 2, binding = 1) buffer CulledBlades {
    Blade blades[];
} culledBlades;

layout(set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

layout(set = 2, binding = 3) buffer CulledFlowers {
    Blade blades[];
} culledFlowers;

layout(set = 2, binding = 4) buffer FlowerDraw {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
} flowerDraw;

layout(push_constant) uniform FlowerCullSettings {
    float density;
    uint enabled;
} flowerSettings;

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= inputBlades.blades.length()) {
        return;
    }

    Blade blade = inputBlades.blades[index];

    vec3 v0 = blade.v0.xyz;
    vec3 v1 = blade.v1.xyz;
    vec3 v2 = blade.v2.xyz;
    vec3 up = blade.up.xyz;

    float orientation = blade.v0.w;
    float height = blade.v1.w;
    float width = blade.v2.w;
    float stiffness = blade.up.w;
    vec3 front = normalize(cross(
        up, vec3(sin(orientation), 0.0, cos(orientation))));

    // STABLE TIP-PARTICLE PHYSICS
    //
    // The old implementation added force directly to position and then
    // applied a frame-dependent hard correction. That has no velocity state
    // and oscillates when deltaTime varies. This version keeps velocity,
    // integrates it with bounded substeps, and projects it onto the tangent
    // plane after enforcing the fixed blade length.
    vec3 tip = v2;
    vec3 velocity = blade.velocity.xyz;
    vec3 restTip = v0 + up * height;

    float frameDt = clamp(deltaTime, 0.0, 1.0 / 30.0);
    int substepCount = clamp(int(ceil(frameDt / (1.0 / 120.0))), 1, 4);
    float stepDt = frameDt / float(substepCount);

    float windWave = sin(totalTime * 1.65 +
                         v0.x * 0.55 + v0.z * 0.43);
    float windDetail = sin(totalTime * 2.7 +
                           v0.x * 1.31 - v0.z * 0.87);
    vec3 windDirection = normalize(vec3(1.0, 0.0, 0.28));
    vec3 windAcceleration = windDirection *
        (0.72 * windWave + 0.18 * windDetail);
    vec3 gravityAcceleration = vec3(0.0, -0.32, 0.0);

    for (int step = 0; step < substepCount; ++step) {
        // Stiffness from the JSON now acts as a spring frequency. The scale
        // keeps the original 7..13 range responsive without becoming stiff
        // enough to require many solver iterations.
        vec3 recoveryAcceleration =
            (restTip - tip) * (stiffness * 1.35);
        vec3 acceleration = recoveryAcceleration +
            gravityAcceleration + windAcceleration;

        // Semi-implicit Euler: velocity first, position second.
        velocity += acceleration * stepDt;
        velocity *= exp(-5.2 * stepDt);
        tip += velocity * stepDt;

        // One tip particle represents an inextensible blade. Keep it exactly
        // one blade height from the root, then remove radial velocity so the
        // next frame cannot immediately fight the constraint.
        vec3 rootToTip = tip - v0;
        float rootToTipLength = length(rootToTip);
        vec3 bladeAxis = rootToTipLength > 0.000001
            ? rootToTip / rootToTipLength
            : up;
        tip = v0 + bladeAxis * height;
        velocity -= bladeAxis * dot(velocity, bladeAxis);

        // Grass is allowed to lean but not turn underneath the terrain.
        if (dot(bladeAxis, up) < 0.35) {
            vec3 horizontal = bladeAxis - up * dot(bladeAxis, up);
            horizontal = length(horizontal) > 0.000001
                ? normalize(horizontal)
                : front;
            bladeAxis = normalize(up * 0.35 + horizontal *
                                  sqrt(1.0 - 0.35 * 0.35));
            tip = v0 + bladeAxis * height;
            velocity -= bladeAxis * dot(velocity, bladeAxis);
        }
    }

    vec3 tipDirection = normalize(tip - v0);
    float lean = clamp(length(tipDirection - up), 0.0, 1.0);
    vec3 v1corr = v0 + up * height * mix(0.52, 0.40, lean);
    v1corr += (tip - restTip) * 0.18;
    vec3 v2corr = tip;

    if (any(isnan(v1corr)) || any(isnan(v2corr)) ||
        any(isnan(velocity)) || length(velocity) > 8.0) {
        v1corr = v0 + up * height * 0.5;
        v2corr = restTip;
        velocity = vec3(0.0);
    }

    blade.v1.xyz = v1corr;
    blade.v2.xyz = v2corr;
    blade.velocity.xyz = velocity;

    // Write back to preserve state
    inputBlades.blades[index] = blade;

    // CULLING TESTS

    // Orientation culling
    vec3 cameraPos = inverse(camera.view)[3].xyz;
    vec3 viewDir = normalize(v0 - cameraPos);
    vec3 bladeDir = normalize(cross(up, front));

    float orientationThreshold = 0.9;
    bool grassOrientationVisible =
        abs(dot(viewDir, bladeDir)) <= orientationThreshold;

    // View-frustum culling
    vec3 m = 0.25 * v0 + 0.5 * v1corr + 0.25 * v2corr;

    vec4 clipV0 = camera.proj * camera.view * vec4(v0, 1.0);
    vec4 clipV2 = camera.proj * camera.view * vec4(v2corr, 1.0);
    vec4 clipM = camera.proj * camera.view * vec4(m, 1.0);

    float tolerance = 1.0;

    float hV0 = clipV0.w + tolerance;
    float hV2 = clipV2.w + tolerance;
    float hM = clipM.w + tolerance;

    bool v0InFrustum = abs(clipV0.x) <= hV0 && abs(clipV0.y) <= hV0 && abs(clipV0.z) <= hV0;
    bool v2InFrustum = abs(clipV2.x) <= hV2 && abs(clipV2.y) <= hV2 && abs(clipV2.z) <= hV2;
    bool mInFrustum = abs(clipM.x) <= hM && abs(clipM.y) <= hM && abs(clipM.z) <= hM;

    if (!v0InFrustum && !v2InFrustum && !mInFrustum) {
        return;
    }

    // Distance culling
    float dist = length(v0 - cameraPos);
    float maxDistance = 50.0;

    if (dist > maxDistance) {
        return;
    }

    // Distance-based random culling
    int numBuckets = 10;
    float bucketSize = maxDistance / float(numBuckets);
    int bucket = int(dist / bucketSize);

    // Use a hash to randomly cull based on distance
    uint hash = uint(v0.x * 12345.0 + v0.z * 67890.0 + index * 1000);
    float cullProbability = float(bucket) / float(numBuckets);

    if ((hash % 100) / 100.0 < cullProbability) {
        return;
    }


    // WRITE TO CULLED BUFFER

    if (grassOrientationVisible) {
        uint outputIndex = atomicAdd(numBlades.vertexCount, 1);
        culledBlades.blades[outputIndex] = blade;
    }

    // Flowers share the simulation, frustum test and distance culling, but
    // skip grass-card orientation culling because the blossom is radial.
    if (flowerSettings.enabled != 0u) {
        uint flowerHash = index * 747796405u + 2891336453u;
        flowerHash = ((flowerHash >> ((flowerHash >> 28u) + 4u)) ^
                      flowerHash) * 277803737u;
        flowerHash = (flowerHash >> 22u) ^ flowerHash;
        float selection = float(flowerHash & 65535u) / 65535.0;
        if (selection < flowerSettings.density) {
            uint flowerIndex = atomicAdd(flowerDraw.instanceCount, 1);
            culledFlowers.blades[flowerIndex] = blade;
        }
    }
}
